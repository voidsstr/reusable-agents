{
  "schema_version": "1",
  "_comment": "Per-site inline-link guard config (framework/core/article_link_guard.py). Storage copy at config/article-link-guard-config.json overrides this repo default. Site key matches by substring against the rec's agent_id/site hint. Kitchen knobs: kitchen_roots = path roots counted as kitchen links; kitchen_category_template / kitchen_product_template = crawlable link shapes the writer is told to use when the proposer split its slugs (expected_kitchen_category_slugs / expected_kitchen_product_slugs); kitchen_buy_template = optional affiliate click-out for an explicit buy link; kitchen_link_template = shape for the legacy unsplit list (default /k/, resolves both kinds). kitchen_slug_check = optional post-write repair (implementer run.sh): kitchen links whose slug resolves to no active product / category / static slug are unlinked (anchor text kept) and doubled-brand slugs canonicalized before the guard counts them; table/column names are the site's, validated as SQL identifiers.",
  "default": {
    "min_recipes": 5,
    "min_kits": 2,
    "min_products": 0,
    "site_root": "https://aisleprompt.com"
  },
  "sites": {
    "specpicks": {
      "min_recipes": 0,
      "min_kits": 0,
      "min_products": 3,
      "site_root": "https://specpicks.com"
    },
    "aisleprompt": {
      "kitchen_roots": [
        "/kitchen/category/",
        "/kitchen/",
        "/k/"
      ],
      "kitchen_category_template": "{site_root}/kitchen/category/{slug}",
      "kitchen_product_template": "{site_root}/kitchen/{slug}",
      "kitchen_buy_template": "{site_root}/k/{slug}?source=amazon",
      "kitchen_link_template": "{site_root}/k/{slug}",
      "kitchen_slug_check": {
        "product_table": "kitchen_products",
        "product_active_column": "is_active",
        "category_table": "kitchen_categories",

            "\\b(?:cords?|cables?|plugs?|adapters?|inlets?|splitters?|twist[- ]lock)\\s+(?:[\\w'’-]+\\s+){0,3}?(?:240|220|230)\\s*-?\\s*(?:V|VAC|volts?)\\b"
          ],
          "require_any": [
            "\\b(?:cords?|cables?|adapters?|extensions?|splitters?|pigtails?|whips?|inlets?|hook-?ups?|hooking\\s+up|plug(?:s|ged|ging)?\\s+(?:[\\w'’-]+\\s+){0,3}?in(?:to)?|connect\\w*|feed\\w*|wir(?:e|es|ed|ing)|install\\w*|campgrounds?|RV\\s+parks?|pedestals?|shore\\s+power|dryers?|ranges?|stoves?|welders?|transfer\\s+switch\\w*|interlocks?|compatib\\w*|fits?|works?\\s+with|use\\s+(?:it\\s+|them\\s+)?with|EV\\s+charg\\w*)\\b"

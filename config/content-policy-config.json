    "electrical-year1": {
      "description": "Year-1 boundary (RuntimePicks binding amendment 8): no 240 V / L14-30 / L5-30 / 14-50 cords or their compatibility, and no furnace article or furnace runtime claim. Drop this set from a site's rule_sets when the boundary is lifted.",
      "rules": [

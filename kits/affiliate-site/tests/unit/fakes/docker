#!/usr/bin/env bash
# Stand-in for docker in runLocalSuite.test.ts: logs every call to $FAKE_LOG and
# answers from FAKE_* variables. State lives in $FAKE_DIR.
printf 'docker %s\n' "$*" >> "${FAKE_LOG:?}"
case "$1" in
  inspect)
    fmt=$3
    name=$4
    if [[ $name == "${FAKE_DB_CONTAINER:-fx_postgres}" ]]; then
      case $fmt in
        *State.Running*)
          if [[ ${FAKE_DB_STATUS:-running} != running ]]; then echo false
          elif [[ -e $FAKE_DIR/db-started ]]; then echo true
          else echo "${FAKE_DB_RUNNING:-true}"; fi ;;
        *State.Health*) echo "${FAKE_DB_HEALTH:-healthy}" ;;
        *State.Status*) echo "${FAKE_DB_STATUS:-running}" ;;
        *State.ExitCode*) echo 1 ;;
      esac
    else
      case $fmt in
        *State.Running*) echo "${FAKE_APP_RUNNING:-true}" ;;
        *.Image*) echo "sha256:fakeimage0123456789abcdef" ;;
      esac
    fi
    exit 0
    ;;
  compose)
    shift
    while (($#)); do
      case $1 in
        -p|--project-directory|-f) shift 2 ;;
        *) break ;;
      esac
    done
    case $1 in
      build) [[ -n ${FAKE_BUILD_SLEEP:-} ]] && exec sleep "$FAKE_BUILD_SLEEP"; exit "${FAKE_BUILD_RC:-0}" ;;
      up)
        if [[ " $* " == *" --no-deps "* ]]; then exit "${FAKE_UP_RC:-0}"; fi
        [[ ${FAKE_DB_UP_RC:-0} == 0 ]] && touch "$FAKE_DIR/db-started"
        exit "${FAKE_DB_UP_RC:-0}"
        ;;
      *) exit 0 ;;
    esac
    ;;
  exec) cat > "$FAKE_DIR/freshen.in"; exit "${FAKE_PSQL_RC:-0}" ;;
  logs) echo "fake container log line"; exit 0 ;;
  *) exit 0 ;;
esac

# A site's tests/suite.env: the settings of its deploy gate, read by the kit
# runner (vendor/affiliate-kit/tests/run-local-suite.sh). Bash, sourced; keep
# values single-quoted. Any of these set in the environment wins over the file.
# Copy to <site>/tests/suite.env and fill in the <placeholders>.

# Lock and compose project name; the lock is local-suite-<project>.lock.
SUITE_PROJECT='<project>'
# Where the app under test listens on this host, and how the gate reaches it.
SUITE_APP_PORT='<app port no other gate uses>'
SUITE_APP_HOST='127.0.0.1'

# Layout, relative to this file's directory.
SUITE_SITE_ROOT='..'
SUITE_TESTS_DIR='.'
# Compose files, relative to the site root: the first owns the fixture DB,
# the second the app under test (built from the site's production Dockerfile).
SUITE_COMPOSE_FILES='docker-compose.yml docker-compose.test.yml'
SUITE_APP_SERVICE='backend-test'
SUITE_APP_CONTAINER='<project>_backend_test'
SUITE_DB_SERVICE='postgres'
SUITE_DB_CONTAINER='<project>_postgres'

# The fixture Postgres (fixture credentials from the compose file, never a
# secret). Gives the specs KIT_GATE_DB_URL for the database-level checks.
SUITE_DB_PORT='<fixture DB port no other gate uses>'
SUITE_DB_NAME='<fixture database>'
SUITE_DB_USER='<fixture user>'
SUITE_DB_PASSWORD='<fixture password>'
# Re-stamps the fixture's Amazon check times once the app is healthy.
SUITE_FIXTURE_FRESHEN_SQL='db/fixtures/freshen.sql'

SUITE_WORKERS='4'
# Other gates this one must never overlap, held for the whole run (taken all or
# nothing). Name their projects: a named lock file is created when missing, so
# the exclusion holds even before that gate has run since the host booted.
# '*' adds every local-suite-*.lock present when the run starts (best effort
# on its own), e.g. '<other project> <another project> *'.
SUITE_HOST_LOCKS='<other gate projects> *'
SUITE_NICE='10'
# CPU cap: docker update --cpus on the app once it starts; exported, so the
# compose files can set `cpus: ${SUITE_CPUS:-0}` on the app and the fixture DB.
SUITE_CPUS='2'

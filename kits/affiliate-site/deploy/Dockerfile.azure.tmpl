{{RENDER_MARKER}} (kit {{KIT_VERSION}})
#
# Production image for {{APP_NAME}}. Azure Container Apps and ECS Fargate run
# the same image, and the deploy gate tests it before either does.
#
# Do not edit the rendered Dockerfile.azure: change deploy.env (NODE_IMAGE,
# TARGET_PORT, SERVER_ENTRY, BUILD_SCRIPT, HEALTH_PATH, DOCKER_EXTRA_PATHS) or
# this template, then re-render:
#   bash vendor/affiliate-kit/deploy/render-dockerfile.sh --env deploy.env --write
# deploy.sh refuses to build a rendered Dockerfile that has drifted from the template.
#
# SSR only: there is no SPA build stage. `npm run {{BUILD_SCRIPT}}` compiles src/
# together with the vendored kit (vendor/affiliate-kit) into {{SERVER_ENTRY}}.
# No secret is baked in: DATABASE_URL and every other secret arrive at runtime
# as Container App / ECS secrets.
# SSR HTML is served with Cache-Control s-maxage <= 600 (site.json
# cache.htmlSMaxAgeSeconds, enforced by the kit); deploy.sh checks site.json
# before the build and the live response headers after every release.

ARG NODE_IMAGE={{NODE_IMAGE}}

# ---- runtime dependencies only (no devDependencies) ----
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force && mkdir -p node_modules

# ---- build: the server plus the kit it imports ----
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig*.json site.json ./
COPY src ./src
COPY vendor/affiliate-kit ./vendor/affiliate-kit
{{EXTRA_BUILD_COPY}}
RUN npm run {{BUILD_SCRIPT}} \
 && test -f {{SERVER_ENTRY}} \
 || { echo "npm run {{BUILD_SCRIPT}} did not produce {{SERVER_ENTRY}}" >&2; exit 1; }

# ---- runtime ----
FROM ${NODE_IMAGE} AS production
# dumb-init: PID 1 that forwards SIGTERM, so revisions and tasks stop cleanly.
# curl: the container health check (and debugging from a shell in the replica).
RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache dumb-init curl ca-certificates; \
    else \
      apt-get update \
      && apt-get install -y --no-install-recommends dumb-init curl ca-certificates \
      && rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /app
ENV NODE_ENV=production \
    PORT={{TARGET_PORT}}
LABEL org.opencontainers.image.title="{{APP_NAME}}" \
      affiliate-kit.template-version="{{KIT_VERSION}}"
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
COPY --from=build /app/site.json ./site.json
# The kit's SQL migrations and assets; the migrate step runs them from this image.
COPY --from=build /app/vendor/affiliate-kit ./vendor/affiliate-kit
{{EXTRA_RUNTIME_COPY}}
# The code is owned by root and read-only to the server process.
USER node
EXPOSE {{TARGET_PORT}}
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:{{TARGET_PORT}}{{HEALTH_PATH}}" > /dev/null || exit 1
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "{{SERVER_ENTRY}}"]

# deploy.env: the per-site deployment contract for the affiliate-site kit deploy
# templates (vendor/affiliate-kit/deploy/{azure,aws}/*.sh). Copy it to the site
# root as deploy.env and fill it in. Every value here is a site value: the
# scripts hard-code no site, resource or domain name.
#
# Format: KEY=value lines, read by the scripts (never `source`d). Quote a value
# that contains spaces. $, backquotes and other shell syntax are rejected.
# Unknown keys are an error (so a typo cannot silently fall back to a default).
#
# NO SECRETS IN THIS FILE. A secret is named by reference:
#   env:NAME    the environment variable NAME, else NAME in SECRETS_FILE
#   file:PATH   the contents of PATH (~ allowed; keep it mode 0600)
# Secret values are passed to the cloud only through files (az `name=@file`,
# aws `file://`) or through a child process's environment; never on a command
# line, never printed.

# ── Site ─────────────────────────────────────────────────────────────────────
# Container App name, ECS service/task family, image repository and default
# resource name prefix. Lowercase letters, digits and '-', at most 29 chars.
APP_NAME=examplepicks
# The apex domain and every hostname to serve. Each hostname gets a managed
# certificate; the apex is validated over HTTP, subdomains over CNAME.
SITE_DOMAIN=example.com
SITE_HOSTNAMES="example.com www.example.com"
# The site repository (relative to this file). Default: this file's directory.
SITE_ROOT=.
# site.json (relative to SITE_ROOT): deploy.sh checks cache.htmlSMaxAgeSeconds.
SITE_JSON=site.json
# The port the server listens on (PORT in the container, ingress target port).
TARGET_PORT=8080

# ── Image ────────────────────────────────────────────────────────────────────
# The rendered Dockerfile (relative to SITE_ROOT). Render it from the kit
# template with deploy/render-dockerfile.sh; deploy.sh refuses a stale render.
DOCKERFILE=Dockerfile.azure
NODE_IMAGE=node:22-alpine
SERVER_ENTRY=dist/src/index.js
BUILD_SCRIPT=build
HEALTH_PATH=/health
# Extra site directories the build and the runtime image need, besides src/,
# vendor/affiliate-kit/ and site.json. Each must exist in the repository.
DOCKER_EXTRA_PATHS="db content"
DOCKER_PLATFORM=linux/amd64

# ── Compute (both clouds) ────────────────────────────────────────────────────
# 0.5 vCPU / 1 GiB (Fargate: 512 CPU units / 1024 MiB). MIN_REPLICAS must be
# at least 1: a container that scales to zero cold-starts slowly enough that
# AI-assistant fetches time out, and managed-certificate renewal needs a running
# app. The scripts refuse 0.
CPU=0.5
MEMORY=1Gi
MIN_REPLICAS=1
MAX_REPLICAS=3

# ── Container environment and secrets ────────────────────────────────────────
# Where env:NAME secret references are looked up when NAME is not in the
# environment (single-quoted values, the fleet's secrets.env).
SECRETS_FILE=~/.reusable-agents/secrets.env
# Plain (non-secret) container env vars, space-separated NAME=value. PORT is
# added from TARGET_PORT. Names that look secret (PASSWORD, SECRET, TOKEN,
# DATABASE_URL, DSN, API_KEY, CONNECTION_STRING) are refused here.
# Keep PG_POOL_MAX * MAX_REPLICAS within DB_APP_CONNECTION_LIMIT.
APP_ENV="NODE_ENV=production PG_POOL_MAX=5"
# Container secrets: secret-name=<secret ref>. They become Container App
# secrets on Azure and keys of one Secrets Manager secret on AWS.
APP_SECRETS="database-url=env:DATABASE_URL_EXAMPLEPICKS_APP"
# Which container env var reads which secret: ENV_NAME=secret-name.
APP_SECRET_ENV="DATABASE_URL=database-url"
# Addresses whose requests are never AI traffic (the fleet host's audits and
# smoke checks), comma-separated IPs/CIDRs. Empty: the environment, then
# SECRETS_FILE, then this host's public egress address at deploy time (if that
# lookup fails the variable is left out of the release, so set it here when
# the fleet host's address is known).
AI_TRAFFIC_EXCLUDE_IPS=

# ── Database (roles are created on the cloud's shared Postgres server) ───────
DB_NAME=examplepicks
DB_PORT=5432
DB_SSLMODE=require
# Four least-privilege login roles. The owner owns the database and runs the
# migrations; the others get exactly the grants below. The kit marks the roles
# and the database it creates (COMMENT 'affiliate-kit app=<APP_NAME>') and
# refuses to change or drop any that exist without that marker: a name taken
# by another site stops provision.sh database and teardown.sh --with-database.
DB_OWNER_ROLE=examplepicks_owner
DB_APP_ROLE=examplepicks_app
DB_AGENTS_ROLE=examplepicks_agents
DB_PUBLISHER_ROLE=examplepicks_publisher
# Each role's password is taken from its DSN (secret ref), so the role and the
# DSN in secrets.env cannot drift. The DSN user must equal the role name.
# A missing DSN leaves the role without a password (provision exits 3); or let
# `provision.sh database --write-new-dsns FILE` generate them.
DB_OWNER_DSN=env:DATABASE_URL_EXAMPLEPICKS_OWNER
DB_APP_DSN=env:DATABASE_URL_EXAMPLEPICKS_APP
DB_AGENTS_DSN=env:DATABASE_URL_EXAMPLEPICKS
DB_PUBLISHER_DSN=env:DATABASE_URL_EXAMPLEPICKS_PUBLISHER
# CONNECTION LIMIT per role (the database server is shared with other sites).
DB_OWNER_CONNECTION_LIMIT=3
DB_APP_CONNECTION_LIMIT=20
DB_AGENTS_CONNECTION_LIMIT=10
DB_PUBLISHER_CONNECTION_LIMIT=2
# The database's own CONNECTION LIMIT (ALTER DATABASE ... CONNECTION LIMIT), a
# ceiling over all four roles together on the shared server. At least the sum
# of the four limits above; equal to it leaves the admin no slot of its own on
# a server whose admin is not a superuser (Azure flexible server, RDS). Empty:
# left as the server has it.
DB_CONNECTION_LIMIT=
# statement_timeout per role (Postgres units: ms, s, min, h).
DB_OWNER_STATEMENT_TIMEOUT=15min
DB_APP_STATEMENT_TIMEOUT=15s
DB_AGENTS_STATEMENT_TIMEOUT=5min
DB_PUBLISHER_STATEMENT_TIMEOUT=30s
# idle_in_transaction_session_timeout for all four roles ('off': not set).
DB_IDLE_IN_TRANSACTION_TIMEOUT=60s
# Grants: space-separated PRIVILEGES:TABLES, PRIVILEGES from SELECT, INSERT,
# UPDATE, DELETE, each of the first three optionally limited to columns,
# UPDATE(status,published_at); TABLES a comma list, or * for every table (now
# and future; no column lists with *). The grants converge: re-running
# provision's database phase revokes anything not listed. Re-run it after
# migrations add a table named here. The publisher only promotes drafts
# (article_publish_gate sets status and published_at), so it may not rewrite
# an article's content (the publish guard's contract).
DB_APP_GRANTS="SELECT:* INSERT:outbound_clicks,ai_traffic_log"
DB_AGENTS_GRANTS="SELECT,INSERT,UPDATE,DELETE:*"
DB_PUBLISHER_GRANTS="SELECT,UPDATE(status,published_at):editorial_articles"

# ── Deploy ───────────────────────────────────────────────────────────────────
# The pre-deploy gate: deploy/predeploy-gate.sh runs this suite (relative to
# SITE_ROOT) on the tree about to be built and refuses to ship if it fails or
# if the tree changes underneath it.
PREDEPLOY_GATE_SUITE=tests/run-local-suite.sh
PREDEPLOY_GATE_ARGS="--workers=4"
# Migrations run from the image about to ship, as the owner role, before the
# release (docker run --rm -e DATABASE_URL <image> <command>); the owner DSN
# must log in as DB_OWNER_ROLE to DB_NAME. Empty: skipped.
MIGRATE_COMMAND=
# Paths the smoke check fetches after a release: /path expects 200,
# /path=301 expects that status. Every HTML response must keep the cache rule
# (s-maxage <= HTML_MAX_S_MAXAGE, no stale-while-revalidate / stale-if-error,
# CDN-targeted headers within the limit, no Age above it). List at least one
# product page and one best-of list that exist: they quote prices, which is
# what the rule protects (the check warns when it saw fewer than two HTML pages).
SMOKE_PATHS="/ /health /robots.txt /llms.txt /sitemap.xml /best/example-best-list /product/B0EXAMPLE00"
SMOKE_TIMEOUT_SECONDS=180
HTML_MAX_S_MAXAGE=600
# How long to wait for a new revision/task set to become ready.
READY_TIMEOUT_SECONDS=600

# ── Azure (Container Apps; the fleet's shared resources) ─────────────────────
# AZ_SUBSCRIPTION: optional subscription id the scripts insist on.
AZ_SUBSCRIPTION=
AZ_RESOURCE_GROUP=nsc-apps
AZ_LOCATION=eastus
AZ_ENVIRONMENT=nsc-apps-env
AZ_ACR=nscappsacr
AZ_LOG_WORKSPACE=nsc-logs
# Postgres flexible server; the host defaults to its FQDN.
AZ_PG_SERVER=nscappsdb
AZ_DB_HOST=
AZ_DB_ADMIN_USER=nscadmin
AZ_DB_ADMIN_PASSWORD=env:NSCAPPSDB_ADMIN_PASSWORD

# ── AWS (ECS Fargate behind the shared ALB; parallel target) ─────────────────
# Written by reusable-agents/install/deploy-aws.sh provision.
AWS_STATE_FILE=~/.aws-deploy/state.env
# Secrets Manager secret holding APP_SECRETS (required by the AWS scripts).
AWS_SECRET_ID=nsc/examplepicks
# Target group name (default tg-<APP_NAME>, at most 32 chars).
AWS_TARGET_GROUP=
AWS_CPU_TARGET_PERCENT=60
AWS_SSL_POLICY=ELBSecurityPolicy-TLS13-1-2-2021-06
# RDS host defaults to RDS_ENDPOINT from the state file. The admin login is
# required by the database phase and teardown.sh --with-database.
AWS_DB_HOST=
AWS_DB_ADMIN_USER=nscadmin
AWS_DB_ADMIN_PASSWORD=file:~/.aws-rds-pw
# The AWS database has its own host, so DSN-bearing refs may differ per cloud.
# Empty: the shared values above (APP_SECRETS, DB_*_DSN).
AWS_APP_SECRETS=
AWS_DB_OWNER_DSN=
AWS_DB_APP_DSN=
AWS_DB_AGENTS_DSN=
AWS_DB_PUBLISHER_DSN=

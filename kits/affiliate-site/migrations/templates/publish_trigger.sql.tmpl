-- Publish guard for editorial_articles (affiliate-site kit {{kit_version}}, rendered
-- from migrations/templates/publish_trigger.sql.tmpl by
-- server/src/db/publishTrigger.ts; do not edit the rendered copy by hand,
-- re-render it with new parameters into a NEW site migration instead).
--
--   publisher role     {{publisher_role}}
--   draft status       {{draft_status}}
--   published status   {{published_status}}
--   content columns    {{content_columns}}
--
-- WHY. On a site with a content policy, publishing is a gated state change
-- (affiliate-site kit design, binding amendment 1). The article author INSERTs its
-- own rows and used to write them as published, so they skipped every guard.
-- With this migration only the publisher role can put a row into, or keep it
-- in, the published state with content it has not seen; the publish gate
-- (framework/cli/article_publish_gate.py) is the one writer that logs in as
-- that role, and it promotes a draft only when the link guard, the link
-- classes, the claims guard and the content policy all pass.
--
-- THE CONTENT COLUMNS are what those checks read: the text (title, subtitle,
-- excerpt, body_md, faqs, outbound_citations) and category, which picks the
-- claims guard's and link guard's per-bucket policy (the gate reads `bucket`,
-- else `category`; a site that adds a `bucket` column lists it too).
--
-- RULES, for every write by a role other than {{publisher_role}}:
--   INSERT                       status := '{{draft_status}}' and published_at :=
--                                NULL, whatever was asked (an author's INSERT
--                                ... ON CONFLICT DO UPDATE takes the UPDATE
--                                rules on its conflict path).
--   UPDATE asking for '{{published_status}}'
--     row was not published      status kept: a row in the gate's queue
--                                ('{{draft_status}}') stays queued, and a held
--                                row (archived, ...) stays held. Only the
--                                publisher publishes; only a write asking for
--                                '{{draft_status}}' resubmits a held row.
--     row was published and a    status := '{{draft_status}}' (the new content has
--     content column changed     not been checked; the gate re-checks it).
--     row was published, no      kept published. Housekeeping writes such as
--     content column changed     view_count = view_count + 1 on every page view,
--                                hero swaps, featured rotation, trend scores
--                                and related-link arrays must not unpublish an
--                                article.
--   UPDATE asking for any other status (draft, archived, ...)
--                                kept as asked: leaving the published state is
--                                always allowed.
--   UPDATE setting published_at to NULL
--                                the old value is kept once there is one.
-- PUBLISHED_AT is the first go-live time. The INSERT rule clears whatever the
-- author wrote, the gate's promote stamps it (COALESCE(published_at, now())),
-- and no later write by another role clears it: a draft held for days goes
-- live dated the day it went live, and an edited or resubmitted article keeps
-- its first date. Setting another time is allowed (published_at is not
-- content), so a fixture can re-date its articles.
-- AN AUTHOR'S UPSERT leaves status out of its DO UPDATE list, or asks for
-- '{{published_status}}' there. status = EXCLUDED.status asks for
-- '{{draft_status}}' (EXCLUDED carries what the INSERT rule forced), and that
-- resubmits a held row.
-- Writes by {{publisher_role}} pass the guard unchanged. The gate's promote is
--   UPDATE editorial_articles SET status = '{{published_status}}' ... RETURNING status
-- and a RETURNING value of '{{draft_status}}' tells it the connection was not the
-- publisher role ("trigger-kept-draft"), so a misconfigured DSN fails closed.
-- Only status = '{{published_status}}' may ever render publicly.
--
-- TWO TRIGGERS, both ENABLE ALWAYS (they fire under session_replication_role =
-- replica too):
--   editorial_articles_zzz_publish_guard_trg    BEFORE INSERT OR UPDATE: applies
--       the rules above. BEFORE triggers fire in name order (bytewise); 'zzz'
--       puts it after the kit's and the reference site's editorial_articles_*
--       triggers, but a trigger whose name sorts after it (set_*, trg_*)
--       fires later.
--   editorial_articles_zzz_publish_recheck_trg  AFTER INSERT OR UPDATE of a row
--       stored as '{{published_status}}', a NOT DEFERRABLE constraint trigger:
--       re-checks the row as written and raises an error when it breaks the
--       rules, or when a write by {{publisher_role}} changed its content or
--       ran while any trigger on the table runs a function that neither the
--       table owner (or a member of it) nor a superuser owns. A BEFORE trigger
--       that sorts AFTER the guard (set_*, trg_*, ...) can change a row the
--       guard already judged; the recheck makes that write fail instead of
--       publishing unchecked content. Name every other BEFORE trigger so it
--       sorts before editorial_articles_zzz_publish_guard_trg; installing this
--       migration warns about any that does not. Being a constraint trigger,
--       the recheck cannot be swapped by CREATE OR REPLACE TRIGGER (which
--       needs only the TRIGGER privilege); dropping, renaming or disabling it
--       needs the table's owner.
-- A content column is compared on every call by name, so after a content
-- column is dropped or renamed, guarded writes to a published row fail with
-- an error (the page-view counter's fire-and-forget UPDATE included) rather
-- than pass or unpublish the article: re-render the guard in the migration
-- that changes the column. A missing or uncomparable content column, or a
-- missing status or published_at, at install time is an error.
--
-- THE ROLES must keep it meaningful (the site's roles migration or the kit's
-- deploy/ provisioning; the install warns about the first three it can see):
--   * no role but the table owner holds TRIGGER on editorial_articles. GRANT ALL
--     and ALTER DEFAULT PRIVILEGES ... GRANT ALL include it, and so does
--     membership of the owner role. A role that can create a trigger can
--     replace the BEFORE guard (CREATE OR REPLACE TRIGGER needs only that
--     privilege) or add one that sorts after it, and can plant code that runs
--     as whoever writes the row next, the publisher included. The recheck
--     still refuses its own publishing writes, and refuses every publish while
--     a trigger runs a function that neither the owner (or a member of it) nor
--     a superuser owns, so the plant publishes nothing; but until the trigger
--     is gone nothing can be published, and a guard replaced by a temporary
--     function vanishes with its session, after which writes that would have
--     become drafts fail and the gate refuses to run (re-apply this
--     migration's guard). Grant SELECT, INSERT, UPDATE by name.
--   * no BEFORE trigger on editorial_articles sorts after the guard (above).
--   * the author and app roles cannot SET session_replication_role (GRANT SET
--     ON PARAMETER, PostgreSQL 15+, or a managed admin group that has it).
--     ENABLE ALWAYS keeps both triggers firing in replica mode, but
--     pg_restore --disable-triggers and ALTER TABLE ... ENABLE TRIGGER reset
--     them to fire on origin only. After either, run
--       ALTER TABLE editorial_articles
--         ENABLE ALWAYS TRIGGER editorial_articles_zzz_publish_guard_trg,
--         ENABLE ALWAYS TRIGGER editorial_articles_zzz_publish_recheck_trg;
--     Seed fixtures promote through SET ROLE {{publisher_role}}, never replica
--     mode, and set published_at in that same UPDATE (their INSERT left it
--     NULL; a promote that sets only status leaves a live row undated).
--   * the author role (agents) and the app role are not {{publisher_role}}, are
--     not members of it (SET ROLE would pass) and are not superusers;
--   * migrations run as a dedicated owner role. Neither the author role nor the
--     app role owns editorial_articles or is a member of its owner (an owner
--     can DISABLE TRIGGER). Running the migrations from the app's own pool at
--     boot makes the app role the owner;
--   * only the publish gate's process holds the publisher DSN. It is never in
--     an environment or a file an author session can read (keep it out of
--     the agents' shared secrets file);
--   * no SECURITY DEFINER function owned by {{publisher_role}} writes
--     editorial_articles (inside one, current_user is its owner);
--   * {{publisher_role}} needs only SELECT and UPDATE (status, published_at) on
--     editorial_articles.
-- If {{publisher_role}} does not exist yet, this migration warns and nothing can
-- be published until it does (fail closed).
--
-- IDEMPOTENT: CREATE OR REPLACE for the functions and the guard trigger; the
-- recheck, a constraint trigger (which takes no OR REPLACE), is dropped and
-- created again, which takes an ACCESS EXCLUSIVE lock on editorial_articles
-- for the rest of this transaction (lock_timeout bounds the wait). Then ENABLE
-- ALWAYS again (CREATE OR REPLACE TRIGGER and CREATE TRIGGER leave a trigger
-- firing on origin only). PostgreSQL 14 or later.
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '15min';

DO $check$
DECLARE
  missing text[];
  col     text;
  found   text;
BEGIN
  IF to_regclass('editorial_articles') IS NULL THEN
    RAISE EXCEPTION 'publish guard: table editorial_articles does not exist (apply kit_0003 first)';
  END IF;
  -- status and published_at are the guard's own: without published_at every
  -- guarded INSERT would fail ('record "new" has no field').
  SELECT array_agg(c ORDER BY c) INTO missing
    FROM unnest(ARRAY['status', 'published_at', {{content_columns}}]::text[]) AS c
   WHERE NOT EXISTS (
     SELECT 1 FROM pg_attribute a
      WHERE a.attrelid = to_regclass('editorial_articles')
        AND a.attname = c
        AND a.attnum > 0
        AND NOT a.attisdropped);
  IF missing IS NOT NULL THEN
    RAISE EXCEPTION 'publish guard: editorial_articles has no column(s) %', missing;
  END IF;
  -- The guard compares each content column with IS DISTINCT FROM; a type
  -- without an equality operator (json, point, xml) would fail every guarded
  -- write, so it fails here instead. LIMIT 0 reads no row.
  FOREACH col IN ARRAY ARRAY[{{content_columns}}]::text[] LOOP
    BEGIN
      EXECUTE format('SELECT 1 FROM editorial_articles WHERE %1$I IS DISTINCT FROM %1$I LIMIT 0', col);
    EXCEPTION WHEN undefined_function THEN
      RAISE EXCEPTION 'publish guard: content column editorial_articles.% cannot be compared: %', col, SQLERRM;
    END;
  END LOOP;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{publisher_role}}') THEN
    RAISE WARNING 'publish guard: role {{publisher_role}} does not exist yet; until it does nothing can be published';
  END IF;

  -- What else could get a write past the two triggers (warnings: the roles
  -- and triggers are the site's, and some may be created after this file).
  SELECT string_agg(t.tgname::text, ', ' ORDER BY t.tgname::text COLLATE "C") INTO found
    FROM pg_trigger t
   WHERE t.tgrelid = 'editorial_articles'::regclass
     AND NOT t.tgisinternal
     AND (t.tgtype & 3) = 3          -- FOR EACH ROW, BEFORE
     AND (t.tgtype & 20) <> 0        -- on INSERT or UPDATE
     AND t.tgname::text COLLATE "C" > 'editorial_articles_zzz_publish_guard_trg';
  IF found IS NOT NULL THEN
    RAISE WARNING 'publish guard: BEFORE trigger(s) % fire after editorial_articles_zzz_publish_guard_trg (triggers fire in name order) and can change a row the guard already judged; a write they turn into one the guard forbids fails at editorial_articles_zzz_publish_recheck_trg. Rename them to sort before the guard', found;
  END IF;
  SELECT string_agg(r.rolname::text, ', ' ORDER BY r.rolname::text) INTO found
    FROM pg_roles r
   WHERE NOT r.rolsuper
     AND r.rolname <> '{{publisher_role}}'
     AND r.oid <> (SELECT c.relowner FROM pg_class c WHERE c.oid = 'editorial_articles'::regclass)
     AND has_table_privilege(r.oid, 'editorial_articles'::regclass, 'TRIGGER');
  IF found IS NOT NULL THEN
    RAISE WARNING 'publish guard: role(s) % can create triggers on editorial_articles (the TRIGGER privilege: GRANT ALL includes it, and so does membership of the owner role); a trigger runs as whoever writes the row, the publisher included, so the recheck refuses every publish while one runs a function that neither the owner nor a superuser owns. Revoke it and grant SELECT, INSERT, UPDATE by name', found;
  END IF;
  IF current_setting('server_version_num')::int >= 150000 THEN
    EXECUTE $q$
      SELECT string_agg(r.rolname::text, ', ' ORDER BY r.rolname::text)
        FROM pg_roles r
       WHERE NOT r.rolsuper
         AND has_parameter_privilege(r.oid, 'session_replication_role', 'SET')$q$
      INTO found;
    IF found IS NOT NULL THEN
      RAISE WARNING 'publish guard: role(s) % may SET session_replication_role. Both guard triggers are ENABLE ALWAYS and fire in replica mode, but a restore with --disable-triggers or an ENABLE TRIGGER resets them to fire on origin only; keep it from the author and app roles', found;
    END IF;
  END IF;
END
$check$;

CREATE OR REPLACE FUNCTION editorial_articles_publish_guard()
RETURNS trigger
LANGUAGE plpgsql
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  publisher       CONSTANT name   := '{{publisher_role}}';
  draft_status    CONSTANT text   := '{{draft_status}}';
  public_status   CONSTANT text   := '{{published_status}}';
  content_columns CONSTANT text[] := ARRAY[{{content_columns}}]::text[];
  changed boolean;
BEGIN
  IF current_user = publisher THEN
    RETURN NEW;
  END IF;
  -- A new row is a draft whatever it asked for, and undated: published_at is
  -- the first go-live time, which the publish gate stamps when it promotes it.
  IF TG_OP = 'INSERT' THEN
    NEW.status := draft_status;
    NEW.published_at := NULL;
    RETURN NEW;
  END IF;
  -- UPDATE by any other role. It never clears a go-live time (an upsert's
  -- published_at = EXCLUDED.published_at carries the NULL given above).
  IF NEW.published_at IS NULL AND OLD.published_at IS NOT NULL THEN
    NEW.published_at := OLD.published_at;
  END IF;
  -- Leaving the published state is always allowed.
  IF NEW.status IS DISTINCT FROM public_status THEN
    RETURN NEW;
  END IF;
  -- Only the publisher publishes. A row that was not published keeps its
  -- status: a queued row (draft_status) stays queued and a held one
  -- (archived, ...) stays held, until a write asks for draft_status itself.
  IF OLD.status IS DISTINCT FROM public_status THEN
    NEW.status := OLD.status;
    RETURN NEW;
  END IF;
  -- A published row stays published only while its content is unchanged. The
  -- comparison names each column and is parsed on every call, so a dropped or
  -- renamed content column is an error here, never a silent pass.
  EXECUTE (SELECT 'SELECT ' || string_agg(format('($1).%1$I IS DISTINCT FROM ($2).%1$I', c), ' OR ')
             FROM unnest(content_columns) AS c)
     INTO changed
    USING NEW, OLD;
  IF changed THEN
    NEW.status := draft_status;
  END IF;
  RETURN NEW;
END
$fn$;

COMMENT ON FUNCTION editorial_articles_publish_guard() IS
  'Publish guard (kit template publish_trigger.sql.tmpl): writes by any role but {{publisher_role}} cannot make a row published. Their INSERTs are always {{draft_status}} with published_at NULL (the publish gate stamps the first go-live time); an UPDATE asking for {{published_status}} leaves a row that was not published in its status (a held row stays held); an edit to a published row''s content ({{content_columns_plain}}) returns it to {{draft_status}}; and no such UPDATE clears a published_at once set.';

CREATE OR REPLACE FUNCTION editorial_articles_publish_recheck()
RETURNS trigger
LANGUAGE plpgsql
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  publisher       CONSTANT name   := '{{publisher_role}}';
  public_status   CONSTANT text   := '{{published_status}}';
  content_columns CONSTANT text[] := ARRAY[{{content_columns}}]::text[];
  changed     boolean := false;
  broken      text;
  foreign_trg text;
  hint        text := 'Only the publish gate publishes, and only content it checked. A BEFORE trigger that fires after editorial_articles_zzz_publish_guard_trg (triggers fire in name order) changed this row after the guard judged it, or the guard trigger is disabled.';
BEGIN
  -- The trigger's WHEN clause passes only rows stored as published.
  IF TG_OP = 'UPDATE' AND (current_user = publisher OR OLD.status = public_status) THEN
    EXECUTE (SELECT 'SELECT ' || string_agg(format('($1).%1$I IS DISTINCT FROM ($2).%1$I', c), ' OR ')
               FROM unnest(content_columns) AS c)
       INTO changed
      USING NEW, OLD;
  END IF;
  IF current_user = publisher THEN
    IF changed THEN
      broken := format('changed in a write by %s that left it %s', publisher, public_status);
    ELSE
      -- A trigger runs as whoever writes the row: during this write, as the
      -- publisher, so one planted by a role holding TRIGGER could publish
      -- rows the gate never checked (nested writes pass the guard as the
      -- publisher). Publish only while every trigger on the table runs a
      -- function owned by the table owner (or a member of it) or a superuser.
      SELECT string_agg(format('%s (%s, owned by %s)', t.tgname, t.tgfoid::regprocedure, pg_get_userbyid(p.proowner)),
                        ', ' ORDER BY t.tgname::text COLLATE "C")
        INTO foreign_trg
        FROM pg_trigger t
        JOIN pg_proc p ON p.oid = t.tgfoid
        JOIN pg_class c ON c.oid = t.tgrelid
        JOIN pg_roles o ON o.oid = p.proowner
       WHERE t.tgrelid = TG_RELID
         AND NOT t.tgisinternal
         AND NOT o.rolsuper
         AND NOT pg_has_role(p.proowner, c.relowner, 'MEMBER');
      IF foreign_trg IS NOT NULL THEN
        broken := format('published by %s while trigger(s) %s run a function that neither the table owner (%s) nor a superuser owns',
                         publisher, foreign_trg, (SELECT pg_get_userbyid(c.relowner) FROM pg_class c WHERE c.oid = TG_RELID));
        hint := 'A trigger runs as whoever writes the row, here the publisher, so nothing is published while one of these exists. For a trigger of the site''s own, ALTER FUNCTION ... OWNER TO the table owner (after the table changed owner, the guard and recheck functions too); otherwise drop the trigger and revoke TRIGGER on editorial_articles from every role but the owner.';
      END IF;
    END IF;
  ELSIF TG_OP = 'INSERT' THEN
    broken := format('inserted as %s by %s', public_status, current_user);
  ELSIF OLD.status IS DISTINCT FROM public_status THEN
    broken := format('made %s by %s', public_status, current_user);
  ELSIF changed THEN
    broken := format('edited by %s and left %s', current_user, public_status);
  END IF;
  IF broken IS NOT NULL THEN
    RAISE EXCEPTION 'publish guard: editorial_articles row % was %', coalesce(to_jsonb(NEW) ->> 'slug', '?'), broken
      USING ERRCODE = 'check_violation',
            HINT = hint;
  END IF;
  RETURN NULL;
END
$fn$;

COMMENT ON FUNCTION editorial_articles_publish_recheck() IS
  'Publish guard recheck (kit template publish_trigger.sql.tmpl), a constraint trigger AFTER INSERT OR UPDATE of a row stored as {{published_status}}: raises when a role other than {{publisher_role}} left it published against the guard''s rules, when a write by {{publisher_role}} changed its content ({{content_columns_plain}}), or when {{publisher_role}} wrote it while a trigger on the table runs a function that neither the table owner nor a superuser owns.';

CREATE OR REPLACE TRIGGER editorial_articles_zzz_publish_guard_trg
  BEFORE INSERT OR UPDATE ON editorial_articles
  FOR EACH ROW EXECUTE FUNCTION editorial_articles_publish_guard();

-- A constraint trigger, so CREATE OR REPLACE TRIGGER (TRIGGER privilege only)
-- cannot swap it, and NOT DEFERRABLE, so SET CONSTRAINTS cannot postpone it.
-- Constraint triggers take no OR REPLACE: drop it and create it again.
DROP TRIGGER IF EXISTS editorial_articles_zzz_publish_recheck_trg ON editorial_articles;

CREATE CONSTRAINT TRIGGER editorial_articles_zzz_publish_recheck_trg
  AFTER INSERT OR UPDATE ON editorial_articles
  NOT DEFERRABLE
  FOR EACH ROW
  WHEN (NEW.status = '{{published_status}}')
  EXECUTE FUNCTION editorial_articles_publish_recheck();

ALTER TABLE editorial_articles
  ENABLE ALWAYS TRIGGER editorial_articles_zzz_publish_guard_trg,
  ENABLE ALWAYS TRIGGER editorial_articles_zzz_publish_recheck_trg;

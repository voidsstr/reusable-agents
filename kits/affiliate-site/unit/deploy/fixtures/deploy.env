# Sample deploy.env for the kit deploy tests. Every Azure / AWS name here is
# deliberately nonexistent, so even a command that escaped the dry-run and the
# stub CLIs could not touch a real resource.
APP_NAME=kitexample
SITE_DOMAIN=kit-example.test
SITE_HOSTNAMES="kit-example.test www.kit-example.test"
SITE_ROOT=site
SITE_JSON=site.json
TARGET_PORT=8080
DOCKERFILE=Dockerfile.azure
NODE_IMAGE=node:22-alpine
SERVER_ENTRY=dist/src/index.js
BUILD_SCRIPT=build
HEALTH_PATH=/health
DOCKER_EXTRA_PATHS="db content"
CPU=0.5
MEMORY=1Gi
MIN_REPLICAS=1
MAX_REPLICAS=3
SECRETS_FILE=secrets.env
APP_ENV="NODE_ENV=production PG_POOL_MAX=5 SITE_ID=kit-example"
APP_SECRETS="database-url=env:KIT_TEST_DATABASE_URL_APP"
APP_SECRET_ENV="DATABASE_URL=database-url"
AI_TRAFFIC_EXCLUDE_IPS=198.51.100.7
DB_NAME=kitexample
DB_OWNER_ROLE=kitexample_owner
DB_APP_ROLE=kitexample_app
DB_AGENTS_ROLE=kitexample_agents
DB_PUBLISHER_ROLE=kitexample_publisher
DB_OWNER_DSN=env:KIT_TEST_DATABASE_URL_OWNER
DB_APP_DSN=env:KIT_TEST_DATABASE_URL_APP
DB_AGENTS_DSN=env:KIT_TEST_DATABASE_URL
DB_PUBLISHER_DSN=env:KIT_TEST_DATABASE_URL_PUBLISHER
DB_APP_CONNECTION_LIMIT=20
DB_APP_STATEMENT_TIMEOUT=15s
MIGRATE_COMMAND="node dist/src/migrate.js"
SMOKE_PATHS="/ /health /robots.txt /llms.txt"
AZ_RESOURCE_GROUP=kit-test-rg-does-not-exist
AZ_LOCATION=eastus
AZ_ENVIRONMENT=kit-test-env-does-not-exist
AZ_ACR=kittestacrdoesnotexist
AZ_LOG_WORKSPACE=kit-test-logs-does-not-exist
AZ_PG_SERVER=kit-test-pg-does-not-exist
AZ_DB_ADMIN_USER=kitadmin
AZ_DB_ADMIN_PASSWORD=env:KIT_TEST_PG_ADMIN_PASSWORD
AWS_STATE_FILE=aws-state.env
AWS_SECRET_ID=nsc/kitexample
AWS_DB_ADMIN_USER=kitadmin
AWS_DB_ADMIN_PASSWORD=env:KIT_TEST_RDS_ADMIN_PASSWORD

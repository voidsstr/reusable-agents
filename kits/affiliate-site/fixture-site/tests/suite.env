# The gate fixture's deploy-gate settings (sourced by tests/run-local-suite.sh).
# A real site's suite.env has the same keys; see ../../tests/README.md.
SUITE_PROJECT='kitfixture'
SUITE_APP_HOST='127.0.0.1'
# Ports of the kit's own fixture, kept apart from every site's gate (a site's
# fixture DB is long-lived, so two gates never share a DB port).
SUITE_APP_PORT='10032'
SUITE_SITE_ROOT='..'
SUITE_TESTS_DIR='.'
SUITE_COMPOSE_FILES='docker-compose.yml docker-compose.test.yml'
SUITE_APP_SERVICE='backend-test'
SUITE_APP_CONTAINER='kitfixture_backend_test'
SUITE_DB_SERVICE='postgres'
SUITE_DB_CONTAINER='kitfixture_postgres'
# Fixture credentials (the compose file's), never a secret.
SUITE_DB_PORT='5434'
SUITE_DB_NAME='kit_fixture'
SUITE_DB_USER='kitfixture'
SUITE_DB_PASSWORD='kitfixture'
SUITE_FIXTURE_FRESHEN_SQL='db/freshen.sql'
SUITE_WORKERS='4'
# Never overlap another gate on this host. The other gates' projects come from
# the reusable-agents site registry's built-in defaults, looked up when this
# file is sourced (offline, the lookup install/create-affiliate-site.sh uses
# for a new site; the kit names no site itself). A named project's lock file is
# created when missing, so the exclusion survives a reboot that emptied the
# lock directory; '*' adds every other local-suite-*.lock present when the run
# starts. Without python3 or the registry (a copy of the kit outside the
# reusable-agents checkout) this is '*' alone: best effort, since a gate that
# has not run since the host booted has no lock file yet.
_kitfx_ra="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." 2>/dev/null && pwd -P)" || _kitfx_ra=''
_kitfx_names="$(python3 -I "$_kitfx_ra/_template/affiliate-site/scaffold/fleet_sites.py" gate-projects --repo "$_kitfx_ra" --except kitfixture 2>/dev/null)" || _kitfx_names=''
SUITE_HOST_LOCKS="${_kitfx_names:+$_kitfx_names }*"
unset _kitfx_ra _kitfx_names
SUITE_NICE='10'
SUITE_CPUS='2'
# The kit's own node_modules, one level above the fixture.
SUITE_NODE_MODULES='../node_modules'

# The gate fixture's deploy-gate settings (sourced by tests/run-local-suite.sh).
# A real site's suite.env has the same keys; see ../../tests/README.md.
SUITE_PROJECT='kitfixture'
SUITE_APP_HOST='127.0.0.1'
# Ports of the kit's own fixture, kept apart from every site's gate (a site's
# fixture DB is long-lived, so two gates never share a DB port).
SUITE_APP_PORT='10032'
SUITE_SITE_ROOT='..'
SUITE_TESTS_DIR='.'
SUITE_COMPOSE_FILES='docker-compose.yml docker-compose.test.yml'
SUITE_APP_SERVICE='backend-test'
SUITE_APP_CONTAINER='kitfixture_backend_test'
SUITE_DB_SERVICE='postgres'
SUITE_DB_CONTAINER='kitfixture_postgres'
# Fixture credentials (the compose file's), never a secret.
SUITE_DB_PORT='5434'
SUITE_DB_NAME='kit_fixture'
SUITE_DB_USER='kitfixture'
SUITE_DB_PASSWORD='kitfixture'
SUITE_FIXTURE_FRESHEN_SQL='db/freshen.sql'
SUITE_WORKERS='4'
# Never overlap another gate on this host. The kit names no site, so this is
# '*' alone: every local-suite-*.lock present when the run starts (best
# effort: a gate that has not run since the host booted has no lock file yet).
# A site's suite.env names the other gates' projects and keeps '*' beside them.
SUITE_HOST_LOCKS='*'
SUITE_NICE='10'
SUITE_CPUS='2'
# The kit's own node_modules, one level above the fixture.
SUITE_NODE_MODULES='../node_modules'

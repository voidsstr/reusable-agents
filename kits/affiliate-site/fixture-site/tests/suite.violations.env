# The violations scenario: the same fixture, rendered from the database that
# 0003_fixture_violations.sql seeds, with the robots policy and llms.txt
# overlays that break the crawler and llms rules. tests/selftest runs the gate
# with it and expects every kit-compliance rule to fail.
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/suite.env"
SUITE_DB_NAME='kit_fixture_violations'
export KIT_FIXTURE_SITE_OVERLAY='site.violations.json'
export KIT_FIXTURE_LLMS_JSON='llms.violations.json'

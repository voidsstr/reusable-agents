# The deploy gate's settings, read by the kit runner
# (vendor/affiliate-kit/tests/run-local-suite.sh, through tests/run-local-suite.sh).
# Bash, sourced; keep values single-quoted. A variable of the same name in the
# environment wins over this file. Every key: vendor/affiliate-kit/tests/suite.env.example.

# Lock and compose project name; the run holds local-suite-{{SLUG}}.lock.
SUITE_PROJECT='{{SLUG}}'
# The app under test on this host. Pick ports no other gate or fixture uses:
# fixture databases are long-lived, so two sites cannot share a DB port.
SUITE_APP_PORT='{{GATE_PORT}}'
SUITE_APP_HOST='127.0.0.1'

SUITE_SITE_ROOT='..'
SUITE_TESTS_DIR='.'
SUITE_COMPOSE_FILES='docker-compose.yml docker-compose.test.yml'
SUITE_APP_SERVICE='backend-test'
SUITE_APP_CONTAINER='{{SLUG}}_backend_test'
SUITE_DB_SERVICE='postgres'
SUITE_DB_CONTAINER='{{SLUG}}_postgres'

# The fixture Postgres (docker-compose.yml; fixture credentials, never secrets).
SUITE_DB_PORT='{{FIXTURE_DB_PORT}}'
SUITE_DB_NAME='{{FIXTURE_DB_NAME}}'
SUITE_DB_USER='{{FIXTURE_DB_USER}}'
SUITE_DB_PASSWORD='{{FIXTURE_DB_PASSWORD}}'
# Seed, then re-stamp, once the app under test is healthy (its migrations have run).
SUITE_FIXTURE_FRESHEN_SQL='db/fixtures/seed.sql db/fixtures/freshen.sql'

SUITE_WORKERS='4'
# Never overlap another gate on this host. The run holds these locks for its
# whole length, taken all or nothing: each named gate project's
# local-suite-<project>.lock (created when missing, so the exclusion holds
# even before that gate has run since the host booted: the lock directory is
# on tmpfs), and with '*' any other local-suite-*.lock present when the run
# starts. Named from the reusable-agents site registry at scaffold time; name
# a new site's gate project here when it joins this host.
SUITE_HOST_LOCKS={{shq:HOST_LOCKS}}
SUITE_NICE='10'
SUITE_CPUS='2'
SUITE_NODE_MODULES='node_modules'

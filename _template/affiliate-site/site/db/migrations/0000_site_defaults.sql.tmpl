-- {{SLUG}}: site defaults on the kit's tables. The kit's migrations
-- (vendor/affiliate-kit/migrations, kit_*.sql) run before every file here,
-- under one advisory lock and one ledger (_migrations); see
-- vendor/affiliate-kit/migrations/README.md for the rules a site migration
-- follows. Generated by create-affiliate-site.sh.
--
-- Never edit a file a database has applied: add the next NNNN_<what>.sql.
-- Site files may not start with kit_.
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '15min';

-- Articles an author INSERTs without naming one carry the site's byline
-- (site.json byline.name), not the kit's neutral 'Editorial'. A new byline in
-- site.json needs a new migration that sets the default again.
ALTER TABLE editorial_articles ALTER COLUMN author SET DEFAULT {{sql:BYLINE}};

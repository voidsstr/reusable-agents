# keep-the-lights-on: system config for {{DOMAIN}} (generated by
# reusable-agents install/create-affiliate-site.sh).
#
# The runbook is reusable-agents .claude/skills/keep-the-lights-on/SKILL.md;
# every value for this site lives here (template:
# .claude/skills/keep-the-lights-on/systems/_example.yaml).
#
# NOT ACTIVE until the operator adds a `{{SLUG}}` entry to the skill's
# systems/registry.yaml, which happens once the site is live and its agents
# are registered. Fill in the agent roster then.

system: {{SLUG}}
display_name: {{json:DISPLAY_NAME}}

# ── North star ──
# Success is people who reach Amazon from this site and buy, measured as
# verified-human Amazon clicks, not code shipped, pages generated or articles
# published.
growth:
  north_star: "Grow verified-human Amazon clicks per week (beacon clicks that pass the human_clicks verdict), watched per money placement, on top of organic clicks, indexed pages and IP-verified assistant fetches."
  proxies:
    - name: verified_human_amazon_clicks_7d
      sql: "select count(*) from outbound_clicks_verified_human where clicked_at > now() - interval '7 days'"
      db: {{SLUG}}
      note: "The north star (kit view outbound_clicks_verified_human: via='beacon' rows that pass every human_clicks rule)."
    - name: assistant_fetches_verified_24h
      sql: "select count(*) from ai_traffic_log where kind = 'crawler' and ip_verified is not false and ts > now() - interval '24 hours'"
      db: {{SLUG}}
      note: "Answer-time and crawler fetches from IP-verified AI vendors (ai_traffic_log, kit table)."
    - name: articles_published_total
      sql: "select count(*) from editorial_articles where status = 'published'"
      db: {{SLUG}}
      note: "Editorial depth; volume is not the goal, verified clicks are."

# ── Agents in scope (fill in when they are registered) ──
agents:
  critical: []
  supporting: []

# ── Databases (env-var names in ~/.reusable-agents/secrets.env; deploy.env DB_*_DSN) ──
db:
  {{SLUG}}: DATABASE_URL_{{ENV_IDENT}}

# ── Live URLs to HTTP-probe ──
urls:
  homepage: https://{{DOMAIN}}/
  sitemap: https://{{DOMAIN}}/sitemap.xml
  llms: https://{{DOMAIN}}/llms.txt

# ── Escalation recipient (the fleet operator; never a personal inbox) ──
owner_email: mperry@northernsoftwareconsulting.com

# ── Known non-issues (do not re-flag) ──
known_excluded: []

# ── Cadence (seconds) ──
cadence:
  healthy: 1800
  degraded: 240
  down: 180
  blocked_backoff: 3600

improvement_every_hours: 24

# ── Catalog and licence health: bounded SELECT count(*) probes every tick ──
catalog_health:
  checks:
    - name: amazon_hosted_article_heroes
      db: {{SLUG}}
      sql: "select count(*) from editorial_articles where hero_image_url ~* '(media-amazon|ssl-images-amazon|images-amazon|amazon-adsystem)[.]com'"
      expect_max: 0
      note: "IP License 2(h): an article hero is never an Amazon image. The kit's CHECK constraints refuse new ones; a hit means a constraint was dropped."
    - name: published_articles_24h
      db: {{SLUG}}
      sql: "select count(*) from editorial_articles where status = 'published' and published_at > now() - interval '24 hours'"
      note: "Gauge: publish pulse. A content-policy site publishes only through the publish gate."
    - name: verified_human_amazon_clicks_24h
      db: {{SLUG}}
      sql: "select count(*) from outbound_clicks_verified_human where clicked_at > now() - interval '24 hours'"
      note: "Gauge: the north star's daily pulse."
    # Once the site has a catalog: the share of visible products with a quotable
    # price (USD, >= $1, fetched within 24h), recalled SKUs with a live buy
    # button (expect_max 0), and the 24h purge of Amazon API columns (expect_max 0).

# ── Functional verification against PRODUCTION (read-only @prod-safe specs) ──
functional_tests:
  runner: playwright
  cwd: {{SITE_DIR}}/tests
  target: production
  base_url: https://{{DOMAIN}}
  full_cmd: "TEST_URL=https://{{DOMAIN}} npx playwright test --grep @prod-safe --reporter=line --workers=2"
  smoke_cmd: "TEST_URL=https://{{DOMAIN}} npx playwright test --grep @prod-safe --reporter=line --workers=2"
  total_tests: 0
  run_every_hours: 24
  run_smoke_after_prod_change: true
  coverage_areas:
    - health, robots.txt, llms.txt and sitemaps
    - AI answer-time fetchers get what a browser gets
    - every page family renders (the deploy gate covers the rest on the fixture)

# ── Standing incidents (operator-gated) ──
standing_incidents: []

history: []

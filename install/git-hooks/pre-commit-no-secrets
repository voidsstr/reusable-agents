#!/usr/bin/env bash
# pre-commit: refuse a commit whose added lines contain a live secret from
# ~/.reusable-agents/secrets.env (a DB password inside a DSN, an account key,
# a token). Prints the variable name and file, never the value.
#
# Why (2026-10-03): agent-written scripts had copied the production Postgres
# password into 203 tracked files, one of them in this public repo, and it had
# to be rotated. Code reads credentials from the environment instead.
#
# Installed into each fleet repo by install/install-git-hooks.sh.
# Bypass for a genuine false positive: git commit --no-verify (say why in the
# message).
set -euo pipefail
SECRETS="${REUSABLE_AGENTS_SECRETS:-$HOME/.reusable-agents/secrets.env}"
[ -r "$SECRETS" ] || exit 0

git diff --cached --no-color -U0 --diff-filter=ACM | SECRETS="$SECRETS" python3 -c '
import os, re, sys
from urllib.parse import urlparse
vals = {}
for line in open(os.environ["SECRETS"], encoding="utf-8", errors="ignore"):
    m = re.match(r"^\s*(?:export\s+)?([A-Z][A-Z0-9_]*)=(.*)$", line.rstrip("\n"))
    if not m:
        continue
    key, v = m.group(1), m.group(2).strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\x27\"":
        v = v[1:-1]
    if v.startswith(("postgres://", "postgresql://")):
        pw = urlparse(v).password
        if pw and len(pw) >= 8:
            vals[pw] = key
        continue
    for part in v.split(";"):
        if part.startswith("AccountKey=") and len(part) > 30:
            vals[part[len("AccountKey="):]] = key
    if re.search(r"(KEY|SECRET|TOKEN|PASSWORD|PASS|PWD)$", key) and len(v) >= 16 and " " not in v:
        vals[v] = key
hits, current = [], None
for line in sys.stdin:
    if line.startswith("+++ b/"):
        current = line[6:].strip()
    elif line.startswith("+") and not line.startswith("+++"):
        for v, key in vals.items():
            if v in line:
                hits.append((current, key))
if hits:
    sys.stderr.write("pre-commit: refusing to commit live secrets from secrets.env:\n")
    for f, key in sorted(set(hits)):
        sys.stderr.write(f"  {f}: value of {key}\n")
    sys.stderr.write("Read them from the environment instead (e.g. process.env.DATABASE_URL_SPECPICKS,\n"
                     "os.environ.get(\"DATABASE_URL_AISLEPROMPT\"), \"${AZURE_STORAGE_KEY:?}\").\n")
    sys.exit(1)
'
